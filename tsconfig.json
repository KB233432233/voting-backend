{
  "compilerOptions": {
    // Output and source layout
    "rootDir": "./src",              // Compile only src/, not root
    "outDir": "./dist",
    "ignoreDeprecations": "6.0",              // Emit all files to dist/

    // Environment: Node.js
    "target": "ES2020",              // Node 14+ supports ES2020
    "module": "commonjs",            // CommonJS for Node
    "moduleResolution": "node",      // Standard Node resolution
    "esModuleInterop": true,         // Enables default imports from CommonJS
    "types": ["node"],               // Include Node types
    "resolveJsonModule": true,       // Allow importing JSON

    // Type-checking strictness
    "strict": true,                  // Enable all strict checks
    "skipLibCheck": true,            // Skip type checking of declaration files
    "forceConsistentCasingInFileNames": true,

    // Additional outputs
    "sourceMap": true,               // For debugging
    "declaration": false,            // Not needed unless you're publishing

    // Exclude these from compilation
    "allowImportingTsExtensions": false,  // Don't allow .ts imports
    "noEmit": false,                       // ✅ Ensures output is generated!
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src/**/*"],           // Only compile files in src/
  "exclude": ["node_modules", "dist", "prisma", "**/*.test.ts"]
}
